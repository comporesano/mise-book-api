# Приложение
APP_NAME="Booking API for MISE"
DEBUG=true

# PostgreSQL
# Локально: host=localhost. В Docker: хост - имя сервиса db (см. docker-compose.yml)
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=bookings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Строка подключения приложения к PostgreSQL
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/bookings
